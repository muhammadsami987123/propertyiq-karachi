# PropertyIQ backend configuration
# Copy this file to .env and fill in real values for local/production use.
# Never commit a .env file with real secrets.

# Token required in the X-Admin-Token header for all /api/admin/* endpoints.
# This is a PLACEHOLDER — replace with a strong random value before deploying.
ADMIN_TOKEN=changeme-admin-token-please-override

# Comma-separated list of allowed CORS origins, or "*" to allow all (dev only).
CORS_ORIGINS=*

# Enable FastAPI debug mode (verbose error pages). Keep false in production.
DEBUG=false
