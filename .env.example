# PropertyIQ backend configuration
# Copy this file to .env and fill in real values for local/production use.
# Never commit a .env file with real secrets.

# Token required in the X-Admin-Token header for all /api/admin/* endpoints.
# This is a PLACEHOLDER. The app REFUSES TO START with this value unless
# DEBUG=true — generate a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=changeme-admin-token-please-override

# Comma-separated list of allowed CORS origins. "*" allows all origins but
# then credentialed requests (cookies/auth headers) are automatically
# disabled, since a wildcard origin + credentials is never safe.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Enable FastAPI debug mode (verbose error pages, allows the placeholder
# ADMIN_TOKEN to boot). Keep false in production. Set true for quick local
# runs if you haven't generated a real ADMIN_TOKEN yet.
DEBUG=true
